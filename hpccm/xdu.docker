FROM debian:trixie-slim AS build

RUN apt-get update -y && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates \
        curl && \
    rm -rf /var/lib/apt/lists/*

RUN curl -fsSL -o /xdu-dist.tar.gz "https://github.com/xdu-project/xdu/releases/download/v0.5.1/xdu-v0.5.1-$(uname -m)-unknown-linux-gnu.tar.gz"

FROM debian:trixie-slim

LABEL org.opencontainers.image.source=https://github.com/xdu-project/xdu \
    org.opencontainers.image.version=v0.5.1

RUN apt-get update -y && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates \
        libstdc++6 && \
    rm -rf /var/lib/apt/lists/*

COPY --from=build /xdu-dist.tar.gz /xdu-dist.tar.gz

RUN mkdir -p /opt/xdu && \
    tar -xzf /xdu-dist.tar.gz -C /opt/xdu && \
    rm -f /xdu-dist.tar.gz

RUN /opt/xdu/bin/xdu --version && \
    /opt/xdu/bin/xdu-find --version && \
    /opt/xdu/bin/xdu-view --version && \
    /opt/xdu/bin/xdu-rm --version

ENV MANPATH=/opt/xdu/share/man:$MANPATH \
    PATH=/opt/xdu/bin:$PATH

RUN groupadd --system xdu && \
    useradd --system --gid xdu --create-home xdu

USER xdu

ENTRYPOINT ["/opt/xdu/bin/xdu"]
