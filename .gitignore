/target
# Generated release artifacts (man pages via scdoc + shell completions via gen-completions).
# Authored source is doc/*.scd + src/cli.rs; share/ is rebuilt in CI and by xdu-release.
/share/
# Python bytecode cache from the factory FSM scripts (.agents/factory/bin/*.py under uv).
__pycache__/
# JetBrains IDE project files (per-developer, not part of the build).
/.idea/
# Benchmark output: raw logs and ad-hoc result documents are per-machine and per-run.
# Only the committed reference measurement is tracked, so a local `bench/run.sh` never
# dirties the tree.
/bench/results/*
!/bench/results/baseline.json
